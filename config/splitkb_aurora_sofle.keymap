#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   GRAVE   |     N1    |     N2    |     N3    |     N4    |     N5    |            |     N6    |     N7    |     N8    |     N9    |     N0    | BACKSPACE |
            // |    TAB    |     Q     |     W     |     E     |     R     |     T     |            |     Y     |     U     |     I     |     O     |     P     |    LBKT   |
            // |    ESC    |     A     |     S     |     D     |     F     |     G     |            |     H     |     J     |     K     |     L     |    SEMI   |    SQT    |
            // |   LSHFT   |     Z     |     X     |     C     |     V     |     B     |   C_MUTE  | |    C_PP   |     N     |     M     |   COMMA   |    DOT    |    FSLH   |   RSHFT   |
            //             |    LGUI   |   LCTRL   |    LALT   |    MO1    |   LCTRL   | |   SPACE   |    MO2    |  KP_ENTER |    RALT   | BACKSPACE |

            bindings = <
&kp GRAVE      &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &kp BACKSPACE
&kp TAB        &kp Q          &kp W          &kp E          &kp R          &kp T          &kp Y          &kp U          &kp I          &kp O          &kp P          &kp LBKT
&kp ESC        &kp A          &kp S          &kp D          &kp F          &kp G          &kp H          &kp J          &kp K          &kp L          &kp SEMI       &kp SQT
&kp LSHFT      &kp Z          &kp X          &kp C          &kp V          &kp B          &kp C_MUTE     &kp C_PP       &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp RSHFT
               &kp LGUI       &kp LCTRL      &kp LALT       &mo 1          &kp LCTRL      &kp SPACE      &mo 2          &kp KP_ENTER   &kp RALT       &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |         |  LG(N1) |  LG(N2) |  LG(N3) |  LG(N4) |  LG(N5) |          |         |         |         |         |  MINUS  |         |
            // | LG(TAB) |    N1   |    N2   |    N3   |    N4   |    N5   |          |    N6   |    N7   |    N8   |    N9   |    N0   |   PLUS  |
            // |         |   BSLH  |    AT   |   LBRC  |   LBKT  |   LPAR  |          |   RPAR  |   RBKT  |   RBRC  |  EQUAL  |  COLON  |  UNDER  |
            // |         |   PIPE  |   AMPS  |   EXCL  |   DLLR  |  PRCNT  |         | |         |  ASTRK  |  CARET  |         |         |         |         |
            //           |         |         |         |         |         | |         |         |         |         |         |

            bindings = <
&trans       &kp LG(N1)   &kp LG(N2)   &kp LG(N3)   &kp LG(N4)   &kp LG(N5)   &trans       &trans       &trans       &trans       &kp MINUS    &trans
&kp LG(TAB)  &kp N1       &kp N2       &kp N3       &kp N4       &kp N5       &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp PLUS
&trans       &kp BSLH     &kp AT       &kp LBRC     &kp LBKT     &kp LPAR     &kp RPAR     &kp RBKT     &kp RBRC     &kp EQUAL    &kp COLON    &kp UNDER
&trans       &kp PIPE     &kp AMPS     &kp EXCL     &kp DLLR     &kp PRCNT    &trans       &trans       &kp ASTRK    &kp CARET    &trans       &trans       &trans       &trans
             &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        raise_layer {
            display-name = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // |   PSCRN   |     F1    |     F2    |     F3    |     F4    |     F5    |            |     F6    |     F7    |     F8    |     F9    |    F10    |    F11    |
            // |  LG(TAB)  |   LG(N1)  |   LG(N2)  |   LG(N3)  |   LG(N4)  |   LG(N5)  |            |    HOME   |   LC(Z)   |   PG_UP   | LS(ENTER) |     N0    |    F12    |
            // |           |    LALT   |   LSHFT   |   LCTRL   |    LGUI   |   ENTER   |            |    LEFT   |    DOWN   |     UP    |   RIGHT   |           |    DEL    |
            // |           |   K_UNDO  |   K_CUT   |   K_COPY  | LC(LS(V)) |    LGUI   |           | |           |    END    |  KP_ENTER |   PG_DN   |           |           |           |
            //             |           |           |           |           |           | |           |           |           |           |           |

            bindings = <
&kp PSCRN      &kp F1         &kp F2         &kp F3         &kp F4         &kp F5         &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &kp F11
&kp LG(TAB)    &kp LG(N1)     &kp LG(N2)     &kp LG(N3)     &kp LG(N4)     &kp LG(N5)     &kp HOME       &kp LC(Z)      &kp PG_UP      &kp LS(ENTER)  &kp N0         &kp F12
&trans         &kp LALT       &kp LSHFT      &kp LCTRL      &kp LGUI       &kp ENTER      &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT      &trans         &kp DEL
&trans         &kp K_UNDO     &kp K_CUT      &kp K_COPY     &kp LC(LS(V))  &kp LGUI       &trans         &trans         &kp END        &kp KP_ENTER   &kp PG_DN      &trans         &trans         &trans
               &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "adjust";

            // ----------------------------------------------------------------------------------------------------------------------------
            // |     BTCLR     |      BT1      |      BT2      |      BT3      |      BT4      |      BT5      |                |               |               |               |               |               |               |
            // |     EXTPWR    |     LA(F4)    |    RGB_HUI    |    RGB_SAD    |    RGB_SAI    |    RGB_EFF    |                |               |               |     C_PREV    |     C_NEXT    |      C_PP     |               |
            // |               |    RGB_BRD    |    RGB_BRI    |   LS(LG(D))   |               |               |                |  LC(LG(LEFT)) |  LC(LG(DOWN)) |   LC(LG(UP))  | LC(LG(RIGHT)) |               |               |
            // |     LSHFT     |               |     LA(F4)    |     LG(C)     |               |               |    RGB_TOG    | |               |               |     LG(M)     |               |               |               |     UNLOCK    |
            //                 |               |               |               |               |               | |               |               |               |               |               |

            bindings = <
&bt BT_CLR         &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3       &bt BT_SEL 4       &none              &none              &none              &none              &none              &none
&ext_power EP_TOG  &kp LA(F4)         &rgb_ug RGB_HUI    &rgb_ug RGB_SAD    &rgb_ug RGB_SAI    &rgb_ug RGB_EFF    &none              &none              &kp C_PREV         &kp C_NEXT         &kp C_PP           &none
&none              &rgb_ug RGB_BRD    &rgb_ug RGB_BRI    &kp LS(LG(D))      &none              &none              &kp LC(LG(LEFT))   &kp LC(LG(DOWN))   &kp LC(LG(UP))     &kp LC(LG(RIGHT))  &none              &none
&kp LSHFT          &none              &kp LA(F4)         &kp LG(C)          &none              &none              &rgb_ug RGB_TOG    &none              &none              &kp LG(M)          &none              &none              &none              &studio_unlock
                   &none              &none              &none              &none              &none              &none              &none              &none              &none              &none
            >;
        };
    };
};
